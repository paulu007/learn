# === Miscellaneous ===
*.class
*.log
*.pyc
*.swp
*.swo
.DS_Store
Thumbs.db
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# === OS ===
[Dd]esktop.ini
$RECYCLE.BIN/

# === IntelliJ / Android Studio ===
*.iml
*.ipr
*.iws
.idea/
# Ignored: local run configs, workspace layout. Keep shared code styles
# by un-ignoring them if your team commits .idea/codeStyles/.

# === VS Code ===
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# === Flutter / Dart / Pub ===
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
.version

# Symbolication / obfuscation outputs
app.*.symbols
app.*.map.json

# Release binaries (CI uploads these as artifacts instead)
*.apk
*.aab
*.ipa
*.dSYM.zip

# === Android ===
# Local SDK path (machine-specific, regenerated by the Flutter tool)
/android/local.properties
/local.properties
/android/.gradle/
/android/captures/
# Android Studio build outputs
/android/app/debug
/android/app/profile
/android/app/release
# Signing secrets — never commit these
/android/key.properties
*.jks
*.keystore
*.p8

# === Linux desktop build ===
/linux/flutter/ephemeral/
/linux/release/

# === Windows desktop build (generated by CI via `flutter create`) ===
/windows/flutter/ephemeral/
/windows/release/

# === macOS / iOS (in case platforms are added later) ===
/macos/Flutter/ephemeral/
/ios/Pods/
ios/.generated/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# === Web (in case web is enabled later) ===
/web/
!/web/index.html
!/web/manifest.json

# === Tests & tooling ===
.test_cache/
dart_test.yaml.bak

# === Claude Code — personal local settings, never commit ===
.claude/settings.local.json
.claude/worktrees/
.claude/todos/

# === Widget Preview ===
.widget_preview/
